{
  "name": "temp-repo-cloner",
  "displayName": "Temp Repo Cloner",
  "description": "Clone a repository into a temporary directory and delete it when closed.",
  "version": "0.0.8",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.cloneTempRepo"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.cloneTempRepo",
        "title": "Clone Temp Repo"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pack": "vsce package",
    "install-extension": "node -e \"const p = require('./package.json'); console.log('code --install-extension ' + p.name + '-' + p.version + '.vsix')\" | sh"
  },
  "devDependencies": {
    "@types/node": "^14.14.37",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.2.3"
  },
  "dependencies": {}
}